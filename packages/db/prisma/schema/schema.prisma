generator client {
  provider = "prisma-client"
  output   = "../generated/client"
  moduleFormat = "esm"
  runtime = "workerd"
}

generator node {
  provider = "prisma-client"
  output   = "../generated/node"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}
