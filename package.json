{
  "name": "sonvox",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/node": "^22.13.14",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "tailwindcss": "^4.1.18",
      "@prisma/client": "^7.2.0",
      "@trpc/server": "^11.7.2",
      "@trpc/client": "^11.7.2",
      "better-auth": "1.5.2",
      "@polar-sh/better-auth": "^1.6.4",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "alchemy": "^0.87.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @sonvox/db db:push",
    "db:studio": "turbo -F @sonvox/db db:studio",
    "db:generate": "turbo -F @sonvox/db db:generate",
    "db:migrate": "turbo -F @sonvox/db db:migrate",
    "deploy": "turbo -F @sonvox/infra deploy",
    "destroy": "turbo -F @sonvox/infra destroy",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@sonvox/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@cloudflare/workers-types": "^4.20251213.0",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@sonvox/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/recordrtc": "^5.6.15",
    "locale-codes": "^1.3.1",
    "nuqs": "^2.8.9",
    "react-dropzone": "^15.0.0",
    "recordrtc": "^5.6.2",
    "turbo": "^2.8.12",
    "typescript": "^5",
    "ultracite": "7.3.2",
    "use-debounce": "^10.1.0",
    "wavesurfer.js": "^7.12.5"
  },
  "packageManager": "bun@1.2.20"
}
