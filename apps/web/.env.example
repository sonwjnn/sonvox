# ===========================================
# Sonvox Environment Configuration
# ===========================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sonvox

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Polar Billing
POLAR_ACCESS_TOKEN=polar_at_xxx
POLAR_PRODUCT_ID=prod_xxx
POLAR_SERVER=sandbox

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=sonvox-voices

# Chatterbox TTS API (Modal deployment)
CHATTERBOX_API_URL=https://your-modal-app--chatterbox-tts.modal.run
CHATTERBOX_API_KEY=your-chatterbox-api-key

# HuggingFace (for Chatterbox model)
HF_ACCESS_TOKEN=hf_xxx
